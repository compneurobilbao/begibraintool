      </RoutineSettingsComponent>
      <CodeComponent name="code_4" plugin="None">
        <Param val="# === CONFIGURACIÓN ESTÁTICA ===&amp;#10;import random&amp;#10;from psychopy import visual&amp;#10;&amp;#10;dvs_cfg = modules[&quot;module_2&quot;][&quot;tests&quot;][&quot;test_6&quot;][&quot;config&quot;]&amp;#10;MAX_TIME = dvs_cfg[&quot;visual_search_image_time&quot;][&quot;value&quot;]&amp;#10;dvs_wait_time = dvs_cfg[&quot;visual_search_wait_time&quot;][&quot;value&quot;]&amp;#10;ROTATION_SPEED = dvs_cfg[&quot;visual_search_rotation_speed&quot;][&quot;value&quot;]&amp;#10;MATRIX_SIZE = dvs_cfg[&quot;visual_search_matrix_size&quot;][&quot;value&quot;]&amp;#10;&amp;#10;try:&amp;#10;    if isinstance(MATRIX_SIZE, (list, tuple)):&amp;#10;        MATRIX_SIZE = [int(x) for x in MATRIX_SIZE]&amp;#10;        print(MATRIX_SIZE)&amp;#10;    else:&amp;#10;        raise ValueError(&quot;Formato no reconocido para visual_search_matrix_size&quot;)&amp;#10;except Exception as e:&amp;#10;    print(f&quot;Error al interpretar visual_search_matrix_size ({raw_matrix_size}): {e}&quot;)&amp;#10;    # Valor por defecto seguro&amp;#10;    MATRIX_SIZE = [3, 3]&amp;#10;&amp;#10;# Velocidad angular de rotación (grados por frame o segundo según el refresh)&amp;#10;#ROTATION_SPEED = 90      # grados/seg&amp;#10;#MAX_TIME = 5.0           # segundos de duración del trial&amp;#10;#MATRIX_SIZE = (3, 3)     # filas x columnas&amp;#10;&amp;#10;# Tamaño de cada disco (imagen)&amp;#10;DISK_SIZE = (0.25, 0.25)  # en unidades PsychoPy&amp;#10;# Puedes ajustarlo según tu imagen o proporción de pantalla&amp;#10;&amp;#10;# Definir los límites de pantalla en unidades PsychoPy&amp;#10;screen_bounds = (-0.89, 0.6, 0.89, -0.6)&amp;#10;&amp;#10;# Definir lista de archivos de imagen de discos&amp;#10;# Cada disco es un archivo individual, por ejemplo &quot;disk.png&quot;&amp;#10;DISK_IMAGE = r&quot;.\images\autogenerated_datasets\visual_search_rings\disk.png&quot;&amp;#10;&amp;#10;# === FUNCIÓN PARA CREAR MATRIZ DE POSICIONES ===&amp;#10;def create_grid_positions(rows, cols, bounds, disk_size):&amp;#10;    &quot;&quot;&quot;&amp;#10;    Crea una lista de posiciones (x, y) distribuidas uniformemente&amp;#10;    dentro de los límites dados de pantalla.&amp;#10;    &quot;&quot;&quot;&amp;#10;    x_min, y_max, x_max, y_min = bounds&amp;#10;    x_positions = np.linspace(x_min + disk_size[0], x_max - disk_size[0], cols)&amp;#10;    y_positions = np.linspace(y_min + disk_size[1], y_max - disk_size[1], rows)&amp;#10;    positions = [(x, y) for y in reversed(y_positions) for x in x_positions]&amp;#10;    return positions&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="frame_rate = win.getActualFrameRate()" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="win.color = 'white'&amp;#10;&amp;#10;# Esperar 2 segundos manteniendo la pantalla en blanco&amp;#10;blankClock = core.Clock()&amp;#10;while blankClock.getTime() &lt; dvs_wait_time:&amp;#10;    win.flip()&amp;#10;    &amp;#10;# ==== INICIALIZAR ESTÍMULOS ====&amp;#10;positions = create_grid_positions(MATRIX_SIZE[0], MATRIX_SIZE[1], screen_bounds, DISK_SIZE)&amp;#10;target_index = random.randint(0, len(positions)-1)&amp;#10;disks = []&amp;#10;&amp;#10;for i, pos in enumerate(positions):&amp;#10;    disk = visual.ImageStim(&amp;#10;        win=win,&amp;#10;        image=DISK_IMAGE,&amp;#10;        pos=pos,&amp;#10;        size=DISK_SIZE,&amp;#10;        ori=0&amp;#10;    )&amp;#10;    disk.rotation_dir = -1 if i == target_index else 1&amp;#10;    disks.append(disk)&amp;#10;&amp;#10;routine_timer = core.Clock()&amp;#10;&amp;#10;# Medir frame rate una sola vez&amp;#10;#frame_rate = win.getActualFrameRate()&amp;#10;if frame_rate is None or frame_rate &lt;= 0:&amp;#10;    frame_rate = 60.0&amp;#10;frame_dur = 1.0 / frame_rate&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="t = routine_timer.getTime()&amp;#10;&amp;#10;if t &lt; MAX_TIME:&amp;#10;    for disk in disks:&amp;#10;        disk.ori += disk.rotation_dir * ROTATION_SPEED * frame_dur&amp;#10;        disk.draw()&amp;#10;else:&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('dynamic_vs_target_index', target_index)&amp;#10;thisExp.addData('dynamic_vs_target_position', positions[target_index])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_4" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <KeyboardComponent name="key_resp_3" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="" valType="str" updates="None" name="deviceLabel"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="True" valType="bool" updates="constant" name="forceEndRoutine"/>
        <Param val="key_resp_3" valType="code" updates="None" name="name"/>
        <Param val="press" valType="str" updates="constant" name="registerOn"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
