      <CodeComponent name="IMAGE_GENERATION" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="##################################################&amp;#10;## EN ESTA RUTINA SE TIENEN QUE GENERAR LOS DATASETS&amp;#10;## TODO: COMPROBAR MÓDULOS SELECCIONADOS --&gt; GENERAR IMÁGENES PARA ESTOS MÓDULOS --&gt; TERMINAR RUTINA&amp;#10;## TODO: AÑADIR BOTON EN LA GUI PARA OMITIR GENERACIÓN DE IMÁGENES.&amp;#10;## TEMP: DEJO LAS IMÁGENES GENERADAS EN SRC/ ANTES DE TOMAR NINGUNA DECISIÓN SOBRE COMO ORGANIZAR ESTA RUTINA, FICHEROS, ETC.&amp;#10;##################################################&amp;#10;&amp;#10;print(&quot;Importando codigo 1...&quot;)&amp;#10;&amp;#10;from python_scripts import colored_silhouettes&amp;#10;&amp;#10;&amp;#10;print(&quot;Importando codigo 2...&quot;)&amp;#10;from python_scripts import blank_silhouettes&amp;#10;print(&quot;Importado codigo 2 :)&quot;)&amp;#10;&amp;#10;from python_scripts import spatial_frequencies&amp;#10;&amp;#10;&amp;#10;print(&quot;Generando siluetas...&quot;)&amp;#10;blank_silhouettes.process_images( # TODO: coger nombres de imágenes desde los archivos de config.&amp;#10;    raw_dir=r&quot;../../../2.DATASETS/begibraintool_image_selection/00_IMAGE_SELECTION_FOR_DEMO&quot;,&amp;#10;    output_dir=r&quot;./images/autogenerated_datasets/module_1_images&quot;,&amp;#10;    apply_bw=False,&amp;#10;    apply_subject_removal=False,&amp;#10;    apply_bg_bw=False,&amp;#10;    apply_subject_bw=False,&amp;#10;    apply_silhouette_creation=True&amp;#10;)&amp;#10;print(&quot;Coloreando siluetas...&quot;)&amp;#10;#colored_silhouettes.generate_from_csv(csv_path='./BL6.csv', output_root='./images/autogenerated_datasets/color_silhouetes') # ruta desde .psyexp&amp;#10;spatial_frequencies.extract_from_folder(&amp;#10;    #input_dir=r&quot;../images/autogenerated_datasets/module_1_images/raw&quot;, o:&amp;#10;    input_dir=r&quot;../../../2.DATASETS/begibraintool_image_selection/00_IMAGE_SELECTION_FOR_DEMO&quot;,&amp;#10;    output_dir=r&quot;../images/autogenerated_datasets/module_1_images/&quot;,&amp;#10;    cpd_ranges=[(1, 3), (4, 6), (10, 18)],&amp;#10;    screen_width_cm=float(30),&amp;#10;    distance_to_screen_cm=float(50),&amp;#10;    dpi=float(300)&amp;#10;)&amp;#10;&amp;#10;# When finised continue to next routine&amp;#10;continueRoutine = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
